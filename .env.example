# Copy this file to `.env` and fill in the values from your Firebase project.
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.

# --- Firebase web config (public values, safe to expose in the browser) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Cloud Messaging (Web Push certificate key) ---
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair
VITE_FIREBASE_VAPID_KEY=

# --- Owner (barber) account ---
# The Google account whose email is set here is the ONLY account that can open the dashboard.
# IMPORTANT: the same email must also be written in `firestore.rules` (function ownerEmail).
VITE_OWNER_EMAIL=
