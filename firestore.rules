
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. إعدادات المالك والمساعدات العامة
    // ============================================================

    function ownerEmail() {
      return 'app.taliani.coiffeur@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == ownerEmail().lower();
    }

    function isDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isPhone(value) {
      return value is string
        && value.matches('^\\+213[2-7][0-9]{7,8}$');
    }

    function isStatus(value) {
      return value in [
        'pending',
        'accepted',
        'accepted_modified',
        'declined',
        'cancelled',
        'in_progress',
        'completed',
        'no_show'
      ];
    }

    function isSource(value) {
      return value in ['online', 'walk_in', 'manual'];
    }

    // ============================================================
    // 2. المستخدمون
    // ============================================================

    match /users/{uid} {

      allow read: if isOwner()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['client', 'owner']
        && (
          request.resource.data.role == 'client'
          || isOwner()
        )
        && request.resource.data.phone is string
        && request.resource.data.fcmToken is string;

      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name',
                 'phone',
                 'phoneAsked',
                 'fcmToken'
               ])
          && request.resource.data.role == resource.data.role
          && request.resource.data.name is string
          && request.resource.data.phone is string
          && request.resource.data.fcmToken is string
        );

      allow delete: if false;
    }

    // ============================================================
    // 3. الخدمات
    // ============================================================

    match /services/{serviceId} {

      allow read: if true;

      allow create, update: if isOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.estimatedMinutes is number
        && request.resource.data.estimatedMinutes >= 5
        && request.resource.data.estimatedMinutes <= 480
        && request.resource.data.active is bool;

      allow delete: if isOwner();
    }

    // ============================================================
    // 4. مساعدات الحجوزات
    // ============================================================

    function validBookingFields(d) {
      return d.keys().hasAll([
          'name',
          'phone',
          'serviceId',
          'serviceName',
          'price',
          'durationMinutes',
          'date',
          'scheduledStart',
          'scheduledEnd',
          'expectedStart',
          'expectedEnd',
          'status',
          'source',
          'notes'
        ])

        && d.name is string
        && d.name.size() >= 3
        && d.name.size() <= 80

        && isPhone(d.phone)

        && d.serviceId is string
        && d.serviceId.size() > 0

        && d.serviceName is string
        && d.serviceName.size() >= 2

        && d.price is number
        && d.price >= 0

        && d.durationMinutes is number
        && d.durationMinutes >= 5
        && d.durationMinutes <= 480

        && isDate(d.date)
        && isTime(d.scheduledStart)
        && isTime(d.scheduledEnd)
        && isTime(d.expectedStart)
        && isTime(d.expectedEnd)

        && isStatus(d.status)
        && isSource(d.source)

        && d.notes is string

        && (
          !('userId' in d)
          || d.userId == null
          || (
            signedIn()
            && d.userId == request.auth.uid
          )
        );
    }

    // مطابقة السعر والمدة واسم الخدمة مع بيانات الخدمة المخزنة.
    function matchesService(d, requireActive) {
      let servicePath = /databases/$(database)/documents/services/$(d.serviceId);

      return exists(servicePath)
        && get(servicePath).data.name == d.serviceName
        && get(servicePath).data.price == d.price
        && get(servicePath).data.estimatedMinutes == d.durationMinutes
        && (
          !requireActive
          || get(servicePath).data.active == true
        );
    }

    // ============================================================
    // 5. الطابور اليومي — مساعدات مشتركة (شكل Map)
    // ============================================================
    //
    // `dailyQueue/{date}.entries` خريطة (Map) مربوطة بمعرّف الحجز:
    //   { [bookingId]: { bookingId, expectedStart, durationMinutes, status } }
    // يقبل القارئ الشكل القديم (Array) أثناء الترحيل، لكن كل كتابة جديدة
    // تُحوِّل المستند إلى شكل الـ Map (ترحيل تدريجي دون فقدان أي مدخل).

    function queueEntryKeys() {
      return ['bookingId', 'expectedStart', 'durationMinutes', 'status'];
    }

    // شكل عنصر واحد سليم (بدون بيانات شخصية).
    function validQueueEntry(e) {
      return e is map
        && e.keys().hasOnly(queueEntryKeys())
        && e.bookingId is string
        && e.bookingId.size() >= 1
        && e.bookingId.size() <= 60
        && isTime(e.expectedStart)
        && e.durationMinutes is number
        && e.durationMinutes >= 5
        && e.durationMinutes <= 480
        && isStatus(e.status);
    }

    // العنصر المخزّن `e` يطابق حالة الحجز `d` بعد الطلب (انسحاق ذري).
    function entryMirrorsBooking(e, bookingId, d) {
      return validQueueEntry(e)
        && e.bookingId == bookingId
        && e.expectedStart == d.expectedStart
        && e.durationMinutes == d.durationMinutes
        && e.status == d.status;
    }

    // عنصر `e` موجود فعلاً تحت مفتاحه الصحيح داخل خريطة `m`
    // (يمنع وضع مدخل حجز تحت مفتاح حجز آخر).
    function entryBoundIn(m, e) {
      let stored = m.get(e.bookingId, null);

      return validQueueEntry(e)
        && stored is map
        && stored.keys().hasOnly(queueEntryKeys())
        && stored.bookingId == e.bookingId
        && stored.expectedStart == e.expectedStart
        && stored.durationMinutes == e.durationMinutes
        && stored.status == e.status;
    }

    // ============================================================
    // 6. الحجوزات
    // ============================================================

    match /bookings/{bookingId} {

      // بعد أي كتابة: مستند طابور يوم الحجز يحمل مدخل هذا الحجز مطابقاً
      // لحالته الجديدة — أي تعديل للحجز يجب أن يصحح طابوره في نفس المعاملة.
      function queueEntryAfter(d) {
        let queuePath = /databases/$(database)/documents/dailyQueue/$(d.date);

        return existsAfter(queuePath)
          && getAfter(queuePath).data.date == d.date
          && getAfter(queuePath).data.entries is map
          && entryMirrorsBooking(
            getAfter(queuePath).data.entries.get(bookingId, null),
            bookingId,
            d
          );
      }

      // عند تغيير التاريخ: يُزال مدخل الحجز من طابور اليوم السابق في نفس
      // الطلب (ويُحوَّل أي طابور قديم من شكل Array إلى Map).
      function queueEntryLeftOldDay(oldDate) {
        let queuePath = /databases/$(database)/documents/dailyQueue/$(oldDate);

        return !existsAfter(queuePath)
          || (
            getAfter(queuePath).data.date == oldDate
            && getAfter(queuePath).data.entries is map
            && getAfter(queuePath).data.entries.get(bookingId, null) == null
          );
      }

      // حجز جديد من الزبون أو الزائر.
      function validOnlineBooking() {
        let d = request.resource.data;

        return validBookingFields(d)

          && d.status == 'pending'
          && d.source == 'online'

          && matchesService(d, true)

          && (
            d.userId == null
            || (
              signedIn()
              && d.userId == request.auth.uid
            )
          )

          && queueEntryAfter(d);
      }

      // حجز ينشئه المالك من لوحة التحكم (يدوي/زبون عابر).
      function validOwnerBooking() {
        let d = request.resource.data;

        return validBookingFields(d)
          && matchesService(d, false);
      }

      allow create: if (
        isOwner()
        && validOwnerBooking()
      ) || validOnlineBooking();

      // المالك يرى كل الحجوزات، والزبون يرى حجوزاته فقط.
      allow read: if isOwner()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // تعديل الحجز من الزبون: كل انتقال مقيّد بحقوله المحددة فقط، ولا يجوز
      // دمج تغييرات حرة مع الانتقال ولا تعديل الحجز دون مزامنة طابوره.
      function clientUpdate() {
        let d = request.resource.data;
        let old = resource.data;
        let changed = d.diff(old).affectedKeys();

        return signedIn()

          && old.userId == request.auth.uid

          // الطابور يتبع الحجز دائماً (كل التواريخ المتأثرة).
          && queueEntryAfter(d)
          && (old.date == d.date || queueEntryLeftOldDay(old.date))

          && (

            // (1) إلغاء الحجز من الزبون.
            (
              d.status == 'cancelled'
              && old.status in [
                'pending',
                'accepted',
                'accepted_modified'
              ]
              && changed.hasOnly(['status', 'updatedAt'])
            )

            ||

            // (2) قبول التوقيت المعدل من الحلاق: يصبح الموعد المعتمد.
            (
              old.status == 'accepted_modified'
              && d.status == 'accepted'
              && old.proposedDate is string
              && d.date == old.proposedDate
              && d.scheduledStart == old.proposedTime
              && d.expectedStart == old.proposedTime
              && isDate(d.date)
              && isTime(d.scheduledStart)
              && isTime(d.scheduledEnd)
              && isTime(d.expectedStart)
              && isTime(d.expectedEnd)
              && d.scheduledEnd == d.expectedEnd
              && d.proposedDate == null
              && d.proposedTime == null
              && changed.hasOnly([
                'status',
                'date',
                'scheduledStart',
                'scheduledEnd',
                'expectedStart',
                'expectedEnd',
                'proposedDate',
                'proposedTime',
                'updatedAt'
              ])
            )

            ||

            // (3) رفض التعديل: عودة الحجز إلى الانتظار دون رسالة مفبركة.
            (
              old.status == 'accepted_modified'
              && d.status == 'pending'
              && d.proposedDate == null
              && d.proposedTime == null
              && d.barberMessage == ''
              && changed.hasOnly([
                'status',
                'proposedDate',
                'proposedTime',
                'barberMessage',
                'updatedAt'
              ])
            )

            ||

            // (4) اقتراح موعد جديد من الزبون (الحجز يبقى قيد الانتظار).
            (
              old.status == 'pending'
              && d.status == 'pending'
              && isDate(d.clientProposedDate)
              && isTime(d.clientProposedTime)
              && changed.hasOnly([
                'clientProposedDate',
                'clientProposedTime',
                'updatedAt'
              ])
            )
          );
      }

      allow update: if isOwner() || clientUpdate();

      allow delete: if isOwner();
    }

    // ============================================================
    // 7. الإشعارات
    // ============================================================

    match /notifications/{notificationId} {

      function validNotification(d) {
        return d.keys().hasOnly([
            'userId',
            'bookingId',
            'title',
            'body',
            'read',
            'createdAt'
          ])

          && d.userId is string
          && d.userId.size() > 0
          && d.userId.size() <= 128

          && d.title is string
          && d.title.size() >= 2
          && d.title.size() <= 120

          && d.body is string
          && d.body.size() <= 500

          && d.read == false

          // لا يمكن تأريخ إشعار لوقت مضى (منع التزوير).
          && d.createdAt == request.time;
      }

      // الزبون يُشعر صاحب الصالون فقط، وبربط الإشعار بحجز يملكه فعلاً —
      // يمنع الإشعارات العشوائية أو الموجّهة لمستخدمين آخرين.
      function clientCanNotifyOwner(d) {
        let settingsPath = /databases/$(database)/documents/settings/public;
        let bookingPath = /databases/$(database)/documents/bookings/$(d.bookingId);

        return signedIn()

          // الهدف هو المالك (منشور في الإعدادات العامة).
          && exists(settingsPath)
          && get(settingsPath).data.keys().hasAll(['ownerUid'])
          && get(settingsPath).data.ownerUid is string
          && get(settingsPath).data.ownerUid == d.userId

          // مرتبط بحجز يملكه المرسل.
          && d.bookingId is string
          && d.bookingId.size() > 0
          && d.bookingId.size() <= 60
          && exists(bookingPath)
          && get(bookingPath).data.userId == request.auth.uid;
      }

      allow read: if isOwner()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // إنشاء: المالك لكل المستخدمين، والزبون لصاحب الصالون وبربط بحجزه.
      allow create: if validNotification(request.resource.data)
        && (
          isOwner()
          || clientCanNotifyOwner(request.resource.data)
        );

      // المستخدم يستطيع تغيير حالة القراءة فقط.
      allow update: if isOwner()

        || (
          signedIn()
          && resource.data.userId == request.auth.uid

          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['read'])

          && request.resource.data.read is bool
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // 8. الإعدادات العامة
    // ============================================================

    match /settings/public {

      allow read: if true;

      allow write: if isOwner();
    }

    // ============================================================
    // 9. الإعدادات الخاصة
    // ============================================================

    match /settings/private {

      allow read, write: if isOwner();
    }

    // ============================================================
    // 10. الطابور اليومي
    // ============================================================

    match /dailyQueue/{day} {

      // هيكل المستند بعد الكتابة: { date, entries (Map), updatedAt }.
      function validQueueDocument(d) {
        return d.keys().hasOnly(['date', 'entries', 'updatedAt'])
          && d.keys().hasAll(['date', 'entries', 'updatedAt'])

          && d.date == day
          && isDate(day)

          && d.entries is map
          && d.entries.size() <= 60

          && d.updatedAt is timestamp;
      }

      // المدخل المضاف/المعدَّل يجب أن يطابق حجزه بعد الطلب، وأن يكون من
      // مفتاحه الصحيح، وأن يخصّ صاحب الطلب (أو حجز ضيف عند إنشائه).
      function entryBelongsToRequester(e) {
        let bookingPath = /databases/$(database)/documents/bookings/$(e.bookingId);

        return validQueueEntry(e)
          && entryBoundIn(request.resource.data.entries, e)

          && existsAfter(bookingPath)
          && getAfter(bookingPath).data.date == day
          && getAfter(bookingPath).data.expectedStart == e.expectedStart
          && getAfter(bookingPath).data.durationMinutes == e.durationMinutes
          && getAfter(bookingPath).data.status == e.status

          && (
            (
              getAfter(bookingPath).data.userId == null
              && !signedIn()
            )
            || (
              signedIn()
              && getAfter(bookingPath).data.userId == request.auth.uid
            )
          );
      }

      // المدخل المُزال يجب أن يخصّ صاحب الطلب، وأن حجزه قد غادر هذا اليوم
      // (النقل إلى يوم آخر) — يمنع حذف مدخلات الآخرين أو إخلاء يوم سليم.
      function entryLeftThisDay(e) {
        let bookingPath = /databases/$(database)/documents/bookings/$(e.bookingId);

        return e is map
          && e.bookingId is string
          && e.bookingId.size() > 0
          && e.bookingId.size() <= 60

          && existsAfter(bookingPath)
          && getAfter(bookingPath).data.date != day

          && (
            (
              getAfter(bookingPath).data.userId == null
              && !signedIn()
            )
            || (
              signedIn()
              && getAfter(bookingPath).data.userId == request.auth.uid
            )
          );
      }

      // ---- الكتابة على مستند قديم (entries: Array) أثناء الترحيل ----
      // يُسمح فقط بالتحويل إلى Map مع إما: لا تغيير في المحتوى، أو تغيير
      // مدخل واحد يخصّ صاحب الطلب، أو إزالة مدخله عندما انتقل إلى يوم آخر.
      //
      // `removeAll` مخصّصة للقوائم فقط، لذلك تُنفَّذ العمليات داخل دالة
      // منفصلة تُستدعى بعد التأكد من شكل البيانات (`&&` يمنع استدعائها).
      function legacyUpdateCore(before, after) {
        let preserved = before.removeAll(after.values());
        let changed = after.values().removeAll(before);

        // لا يمكن فقدان أكثر من مدخل واحد ولا إضافة أكثر من واحد.
        return preserved.size() <= 1
          && changed.size() <= 1

          && (
            // تحويل الشكل فقط (المحتوى نفسه).
            (
              preserved.size() == 0
              && changed.size() == 0
            )

            ||

            // إضافة/تعديل مدخل واحد يخصّ صاحب الطلب.
            (
              preserved.size() == 0
              && changed.size() == 1
              && entryBelongsToRequester(changed[0])
            )

            ||

            // إزالة مدخل صاحب الطلب لأنه غادر هذا اليوم.
            (
              preserved.size() == 1
              && changed.size() == 0
              && entryLeftThisDay(preserved[0])
            )

            ||

            // استبدال مدخله بنفسه (تصحيح/ترحيل) — لا يُمسك مدخل غيره.
            (
              preserved.size() == 1
              && changed.size() == 1
              && preserved[0].bookingId == changed[0].bookingId
              && entryBelongsToRequester(changed[0])
            )
          );
      }

      function legacyQueueUpdate() {
        let before = resource.data.entries;
        let after = request.resource.data.entries;

        return before is list
          && after is map
          && legacyUpdateCore(before, after);
      }

      // ---- الكتابة على مستند حديث (entries: Map) ----
      // عنصر واحد فقط قد يُضاف أو يُعدَّل أو يُزال في كل كتابة، ويجب أن
      // يطابق حجزه بعد الطلب؛ بقية المدخلات تبقى كما هي تماماً.
      function mapUpdateCore(before, after) {
        let changed = after.values().removeAll(before.values());
        let removedKeys = before.keys().removeAll(after.keys());

        return changed.size() + removedKeys.size() <= 1

          && (
            // لا تغيير على المدخلات (مثلاً إعادة كتابة محتوى مطابق).
            (
              changed.size() == 0
              && removedKeys.size() == 0
            )

            ||

            // إضافة أو تعديل مدخل واحد مطابق لحجز صاحب الطلب.
            (
              changed.size() == 1
              && removedKeys.size() == 0
              && entryBelongsToRequester(changed[0])
            )

            ||

            // إزالة مدخل صاحب الطلب لأنه غادر هذا اليوم.
            (
              changed.size() == 0
              && removedKeys.size() == 1
              && entryLeftThisDay(before.get(removedKeys[0], null))
            )
          );
      }

      function mapQueueUpdate() {
        let before = resource.data.entries;
        let after = request.resource.data.entries;

        return before is map
          && after is map
          && mapUpdateCore(before, after);
      }

      // القراءة عامة: مستند خالٍ من البيانات الشخصية (لا أسماء ولا هواتف).
      allow read: if true;

      // المالك يدير الطابور بالكامل (إعادة بناء، ترحيل، تنظيف).
      allow write: if isOwner();

      // أول مدخل في اليوم: إنشاء وثيقة الطابور مع الحجز في المعاملة نفسها.
      allow create: if !isOwner()
        && validQueueDocument(request.resource.data)
        && request.resource.data.entries.size() == 1
        && entryBelongsToRequester(
             request.resource.data.entries.values()[0]
           );

      // أي تعديل لاحق: مدخل واحد كحد أقصى، مربوط بحجزه في نفس المعاملة.
      allow update: if !isOwner()
        && validQueueDocument(request.resource.data)
        && resource.data.date == day
        && (
          (
            resource.data.entries is list
            && legacyQueueUpdate()
          )
          || (
            resource.data.entries is map
            && mapQueueUpdate()
          )
        );
    }

    // ============================================================
    // 11. المنع الافتراضي
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
