
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. إعدادات المالك والمساعدات العامة
    // ============================================================

    function ownerEmail() {
      return 'app.taliani.coiffeur@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == ownerEmail().lower();
    }

    function isDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isPhone(value) {
      return value is string
        && value.matches('^\\+213[2-7][0-9]{7,8}$');
    }

    function isStatus(value) {
      return value in [
        'pending',
        'accepted',
        'accepted_modified',
        'declined',
        'cancelled',
        'in_progress',
        'completed',
        'no_show'
      ];
    }

    function isSource(value) {
      return value in ['online', 'walk_in', 'manual'];
    }

    // ============================================================
    // 2. المستخدمون
    // ============================================================

    match /users/{uid} {

      allow read: if isOwner()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['client', 'owner']
        && (
          request.resource.data.role == 'client'
          || isOwner()
        )
        && request.resource.data.phone is string
        && request.resource.data.fcmToken is string;

      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name',
                 'phone',
                 'phoneAsked',
                 'fcmToken'
               ])
          && request.resource.data.role == resource.data.role
          && request.resource.data.name is string
          && request.resource.data.phone is string
          && request.resource.data.fcmToken is string
        );

      allow delete: if false;
    }

    // ============================================================
    // 3. الخدمات
    // ============================================================

    match /services/{serviceId} {

      allow read: if true;

      allow create, update: if isOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.estimatedMinutes is number
        && request.resource.data.estimatedMinutes >= 5
        && request.resource.data.estimatedMinutes <= 480
        && request.resource.data.active is bool;

      allow delete: if isOwner();
    }

    // ============================================================
    // 4. مساعدات الحجوزات
    // ============================================================

    function validBookingFields(d) {
      return d.keys().hasAll([
          'name',
          'phone',
          'serviceId',
          'serviceName',
          'price',
          'durationMinutes',
          'date',
          'scheduledStart',
          'scheduledEnd',
          'expectedStart',
          'expectedEnd',
          'status',
          'source',
          'notes'
        ])

        && d.name is string
        && d.name.size() >= 3
        && d.name.size() <= 80

        && isPhone(d.phone)

        && d.serviceId is string
        && d.serviceId.size() > 0

        && d.serviceName is string
        && d.serviceName.size() >= 2

        && d.price is number
        && d.price >= 0

        && d.durationMinutes is number
        && d.durationMinutes >= 5
        && d.durationMinutes <= 480

        && isDate(d.date)
        && isTime(d.scheduledStart)
        && isTime(d.scheduledEnd)
        && isTime(d.expectedStart)
        && isTime(d.expectedEnd)

        && isStatus(d.status)
        && isSource(d.source)

        && d.notes is string

        && (
          !('userId' in d)
          || d.userId == null
          || (
            signedIn()
            && d.userId == request.auth.uid
          )
        );
    }

    // مطابقة السعر والمدة واسم الخدمة مع بيانات الخدمة المخزنة.
    function matchesService(d, requireActive) {
      let servicePath = /databases/$(database)/documents/services/$(d.serviceId);

      return exists(servicePath)
        && get(servicePath).data.name == d.serviceName
        && get(servicePath).data.price == d.price
        && get(servicePath).data.estimatedMinutes == d.durationMinutes
        && (
          !requireActive
          || get(servicePath).data.active == true
        );
    }

    // ============================================================
    // 5. التحقق من إضافة الحجز إلى الطابور في نفس المعاملة
    // ============================================================

    function bookingHasQueueEntryAfter(bookingId, d) {
      let queuePath = /databases/$(database)/documents/dailyQueue/$(d.date);

      return existsAfter(queuePath)

        && getAfter(queuePath).data.date == d.date

        && getAfter(queuePath).data.entries is list

        && getAfter(queuePath).data.entries.size() > 0

        && getAfter(queuePath).data.entries[
          getAfter(queuePath).data.entries.size() - 1
        ].bookingId == bookingId

        && getAfter(queuePath).data.entries[
          getAfter(queuePath).data.entries.size() - 1
        ].expectedStart == d.expectedStart

        && getAfter(queuePath).data.entries[
          getAfter(queuePath).data.entries.size() - 1
        ].durationMinutes == d.durationMinutes

        && getAfter(queuePath).data.entries[
          getAfter(queuePath).data.entries.size() - 1
        ].status == d.status;
    }

    // ============================================================
    // 6. الحجوزات
    // ============================================================

    match /bookings/{bookingId} {

      // حجز جديد من الزبون أو الزائر.
      function validOnlineBooking() {
        let d = request.resource.data;

        return validBookingFields(d)

          && d.status == 'pending'
          && d.source == 'online'

          && matchesService(d, true)

          && (
            d.userId == null
            || (
              signedIn()
              && d.userId == request.auth.uid
            )
          )

          && bookingHasQueueEntryAfter(bookingId, d);
      }

      // حجز ينشئه المالك من لوحة التحكم.
      function validOwnerBooking() {
        let d = request.resource.data;

        return validBookingFields(d)
          && matchesService(d, false);
      }

      allow create: if (
        isOwner()
        && validOwnerBooking()
      ) || validOnlineBooking();

      // المالك يرى كل الحجوزات، والزبون يرى حجوزاته فقط.
      allow read: if isOwner()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // تعديل الحجوزات من طرف المالك أو الزبون وفق الحالات المسموحة.
      allow update: if isOwner()

        || (
          signedIn()

          && resource.data.userId == request.auth.uid

          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'status',
                 'date',
                 'scheduledStart',
                 'scheduledEnd',
                 'expectedStart',
                 'expectedEnd',
                 'proposedDate',
                 'proposedTime',
                 'barberMessage',
                 'clientProposedDate',
                 'clientProposedTime',
                 'updatedAt'
               ])

          && (

            // إلغاء الحجز.
            (
              request.resource.data.status == 'cancelled'
              && resource.data.status in [
                'pending',
                'accepted',
                'accepted_modified'
              ]
            )

            ||

            // قبول التوقيت المعدل من الحلاق.
            (
              request.resource.data.status == 'accepted'
              && resource.data.status == 'accepted_modified'
              && request.resource.data.proposedDate == null
            )

            ||

            // رفض التوقيت المعدل.
            (
              request.resource.data.status == 'pending'
              && resource.data.status == 'accepted_modified'
            )

            ||

            // اقتراح موعد جديد من الزبون.
            (
              request.resource.data.status == 'pending'
              && resource.data.status == 'pending'
              && request.resource.data.clientProposedDate is string
              && request.resource.data.clientProposedTime is string
            )
          )
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // 7. الإشعارات
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if isOwner()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // إنشاء الإشعارات محصور بالمالك لمنع الإشعارات العشوائية.
      allow create: if isOwner()

        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120

        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500

        && request.resource.data.read == false;

      // المستخدم يستطيع تغيير حالة القراءة فقط.
      allow update: if isOwner()

        || (
          signedIn()
          && resource.data.userId == request.auth.uid

          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['read'])

          && request.resource.data.read is bool
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // 8. الإعدادات العامة
    // ============================================================

    match /settings/public {

      allow read: if true;

      allow write: if isOwner();
    }

    // ============================================================
    // 9. الإعدادات الخاصة
    // ============================================================

    match /settings/private {

      allow read, write: if isOwner();
    }

    // ============================================================
    // 10. الطابور اليومي
    // ============================================================

    match /dailyQueue/{day} {

      function validQueueEntry(e) {
        return e is map

          && e.keys().hasOnly([
            'bookingId',
            'expectedStart',
            'durationMinutes',
            'status'
          ])

          && e.bookingId is string
          && e.bookingId.size() >= 1
          && e.bookingId.size() <= 60

          && isTime(e.expectedStart)

          && e.durationMinutes is number
          && e.durationMinutes >= 5
          && e.durationMinutes <= 480

          && isStatus(e.status);
      }

      // التحقق من الحجز الذي يقابل العنصر الجديد في الطابور.
      function queueEntryMatchesBooking(e) {
        let bookingPath = /databases/$(database)/documents/bookings/$(e.bookingId);

        return existsAfter(bookingPath)

          && getAfter(bookingPath).data.date == day

          && getAfter(bookingPath).data.expectedStart == e.expectedStart

          && getAfter(bookingPath).data.durationMinutes == e.durationMinutes

          && getAfter(bookingPath).data.status == e.status

          && getAfter(bookingPath).data.source == 'online';
      }

      function validQueueDocument(d) {
        return d.keys().hasOnly([
            'date',
            'entries',
            'updatedAt'
          ])

          && d.date == day
          && isDate(day)

          && d.entries is list
          && d.entries.size() >= 1
          && d.entries.size() <= 60;
      }

      allow read: if true;

      // المالك يدير الطابور بالكامل.
      allow write: if isOwner();

      // أول حجز في اليوم: إنشاء وثيقة الطابور مع الحجز في المعاملة نفسها.
      allow create: if !isOwner()

        && validQueueDocument(request.resource.data)

        && request.resource.data.entries.size() == 1

        && validQueueEntry(request.resource.data.entries[0])

        && queueEntryMatchesBooking(
          request.resource.data.entries[0]
        );

      // حجز إضافي: يسمح بإضافة عنصر واحد فقط.
      allow update: if !isOwner()

        && validQueueDocument(request.resource.data)

        && resource.data.date == day
        && resource.data.entries is list

        && resource.data.entries.size() < 60

        && request.resource.data.entries.size()
             == resource.data.entries.size() + 1

        // يجب أن تبقى العناصر القديمة موجودة.
        && request.resource.data.entries.hasAll(
             resource.data.entries
           )

        // العنصر الأخير هو الحجز الجديد.
        && validQueueEntry(
          request.resource.data.entries[
            request.resource.data.entries.size() - 1
          ]
        )

        // يجب أن يكون الحجز الجديد موجوداً في نفس المعاملة.
        && queueEntryMatchesBooking(
          request.resource.data.entries[
            request.resource.data.entries.size() - 1
          ]
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // 11. المنع الافتراضي
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
